</div>


<!-- DASHBOARD -->

<div
id="dashboard"
class="container"
>


<div class="top-bar">

<div>

<h2>
Applications
</h2>

<p>
CMCHIS application management
</p>

</div>


<div>

<button
class="refresh"
id="refreshButton"
>
Refresh
</button>

<button
class="logout"
id="logoutButton"
>
Logout
</button>

</div>

</div>


<!-- STATISTICS -->

<div class="cards">

<div class="stat-card">

<h3>
Total Applications
</h3>

<p id="totalCount">
0
</p>

</div>


<div class="stat-card">

<h3>
