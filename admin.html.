```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CMCHIS Admin Dashboard</title>

<style>
*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f1f5f9;
    color:#222;
}

header{
    background:linear-gradient(135deg,#0d47a1,#1976d2);
    color:white;
    padding:20px;
    text-align:center;
}

header h1{
    margin:0;
    font-size:25px;
}

header p{
    margin:7px 0 0;
}

.container{
    max-width:1200px;
    margin:25px auto;
    padding:0 15px;
}

/* LOGIN */

.login-box{
    max-width:400px;
    margin:50px auto;
    background:white;
    padding:25px;
    border-radius:15px;
    box-shadow:0 4px 15px rgba(0,0,0,.12);
}

.login-box h2{
    text-align:center;
    color:#0d47a1;
}

input,select{
    width:100%;
    padding:12px;
    margin:7px 0 15px;
    border:1px solid #ccc;
    border-radius:8px;
    font-size:15px;
}

button{
    border:0;
    padding:11px 18px;
    border-radius:7px;
    cursor:pointer;
    font-weight:bold;
}

.login-btn{
    width:100%;
    background:#1565c0;
    color:white;
    font-size:16px;
}

.login-btn:hover{
    background:#0d47a1;
}

.error{
    color:#c62828;
    text-align:center;
    margin-top:10px;
}

/* DASHBOARD */

#dashboard{
    display:none;
}

.top-bar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
    margin-bottom:20px;
}

.logout{
    background:#d32f2f;
    color:white;
}

.logout:hover{
    background:#b71c1c;
}

.cards{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-bottom:25px;
}

.stat-card{
    background:white;
    padding:20px;
    border-radius:12px;
    box-shadow:0 3px 10px rgba(0,0,0,.08);
}

.stat-card h3{
    margin:0;
    color:#666;
    font-size:15px;
}

.stat-card p{
    font-size:28px;
    font-weight:bold;
    margin:10px 0 0;
    color:#0d47a1;
}

/* SEARCH */

.search-box{
    background:white;
    padding:18px;
    border-radius:12px;
    margin-bottom:20px;
}

.search-box input{
    margin:0;
}

/* TABLE */

.table-container{
    background:white;
    border-radius:12px;
    padding:15px;
    overflow-x:auto;
    box-shadow:0 3px 10px rgba(0,0,0,.08);
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:900px;
}

th{
    background:#0d47a1;
    color:white;
    padding:12px;
    text-align:left;
}

td{
    padding:11px;
    border-bottom:1px solid #ddd;
}

tr:hover{
    background:#f5f8fc;
}

.status{
    padding:6px 10px;
    border-radius:15px;
    font-size:12px;
    font-weight:bold;
}

.pending{
    background:#fff3cd;
    color:#856404;
}

.verified{
    background:#d4edda;
    color:#155724;
}

.rejected{
    background:#f8d7da;
    color:#721c24;
}

.view-btn{
    background:#1976d2;
    color:white;
}

.delete-btn{
    background:#d32f2f;
    color:white;
}

/* MODAL */

.modal{
    display:none;
    position:fixed;
    z-index:1000;
    left:0;
    top:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,.55);
    padding:20px;
    overflow:auto;
}

.modal-content{
    max-width:650px;
    margin:40px auto;
    background:white;
    border-radius:15px;
    padding:25px;
}

.close{
    float:right;
    font-size:25px;
    cursor:pointer;
}

.detail{
    margin:10px 0;
    padding:10px;
    background:#f5f7fa;
    border-radius:7px;
}

.detail strong{
    display:block;
    color:#555;
    margin-bottom:4px;
}

.status-select{
    margin-top:15px;
}

/* MOBILE */

@media(max-width:800px){

    .cards{
        grid-template-columns:repeat(2,1fr);
    }

}

@media(max-width:500px){

    .cards{
        grid-template-columns:1fr 1fr;
    }

    header h1{
        font-size:21px;
    }

    .stat-card{
        padding:14px;
    }

    .stat-card p{
        font-size:22px;
    }

}
</style>
</head>

<body>

<header>
    <h1>CMCHIS Admin Dashboard</h1>
    <p>Application Management System</p>
</header>


<!-- LOGIN -->

<div id="loginPage">

    <div class="login-box">

        <h2>Admin Login</h2>

        <label>Username</label>
        <input
            type="text"
            id="username"
            placeholder="Enter username"
        >

        <label>Password</label>
        <input
            type="password"
            id="password"
            placeholder="Enter password"
        >

        <button
            class="login-btn"
            onclick="login()"
        >
            Login
        </button>

        <div
            class="error"
            id="loginError"
        ></div>

    </div>

</div>


<!-- DASHBOARD -->

<div
    id="dashboard"
    class="container"
>

    <div class="top-bar">

        <div>
            <h2>Applications</h2>
            <p>Manage submitted CMCHIS applications</p>
        </div>

        <button
            class="logout"
            onclick="logout()"
        >
            Logout
        </button>

    </div>


    <!-- STATISTICS -->

    <div class="cards">

        <div class="stat-card">
            <h3>Total Applications</h3>
            <p id="totalCount">0</p>
        </div>

        <div class="stat-card">
            <h3>Pending</h3>
            <p id="pendingCount">0</p>
        </div>

        <div class="stat-card">
            <h3>Verified</h3>
            <p id="verifiedCount">0</p>
        </div>

        <div class="stat-card">
            <h3>Rejected</h3>
            <p id="rejectedCount">0</p>
        </div>

    </div>


    <!-- SEARCH -->

    <div class="search-box">

        <input
            type="text"
            id="searchInput"
            placeholder="Search Application ID, name or mobile number..."
            onkeyup="searchApplications()"
        >

    </div>


    <!-- TABLE -->

    <div class="table-container">

        <table>

            <thead>

                <tr>
                    <th>Application ID</th>
                    <th>Name</th>
                    <th>Mobile</th>
                    <th>District</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>

            </thead>

            <tbody id="applicationTable">

            </tbody>

        </table>

    </div>

</div>


<!-- DETAILS MODAL -->

<div
    class="modal"
    id="detailsModal"
>

    <div class="modal-content">

        <span
            class="close"
            onclick="closeModal()"
        >
            &times;
        </span>

        <h2>Application Details</h2>

        <div id="applicationDetails"></div>

        <label>
            Application Status
        </label>

        <select
            id="statusSelect"
            class="status-select"
        >
            <option value="Pending">Pending</option>
            <option value="Verified">Verified</option>
            <option value="Rejected">Rejected</option>
        </select>

        <button
            class="view-btn"
            onclick="updateStatus()"
        >
            Update Status
        </button>

    </div>

</div>


<script>

/* DEMO ADMIN LOGIN */

const ADMIN_USERNAME = "admin";
const ADMIN_PASSWORD = "admin123";

let applications = [];

let selectedApplication = null;


/* LOGIN */

function login(){

    const username =
        document.getElementById("username").value;

    const password =
        document.getElementById("password").value;

    if(
        username === ADMIN_USERNAME &&
        password === ADMIN_PASSWORD
    ){

        document.getElementById("loginPage").style.display =
            "none";

        document.getElementById("dashboard").style.display =
            "block";

        loadApplications();

    }else{

        document.getElementById("loginError").textContent =
            "Invalid username or password.";

    }

}


/* LOGOUT */

function logout(){

    document.getElementById("dashboard").style.display =
        "none";

    document.getElementById("loginPage").style.display =
        "block";

}


/* LOAD DEMO APPLICATIONS */

function loadApplications(){

    const saved =
        localStorage.getItem("cmchisApplications");

    if(saved){

        applications =
            JSON.parse(saved);

    }else{

        applications = [];

    }

    displayApplications(applications);

}


/* DISPLAY APPLICATIONS */

function displayApplications(data){

    const table =
        document.getElementById("applicationTable");

    table.innerHTML = "";

    data.forEach((app,index)=>{

        const row =
            document.createElement("tr");

        row.innerHTML = `

            <td>${app.id || ""}</td>

            <td>${app.name || ""}</td>

            <td>${app.mobile || ""}</td>

            <td>${app.district || ""}</td>

            <td>
                <span class="status ${getStatusClass(app.status)}">
                    ${app.status || "Pending"}
                </span>
            </td>

            <td>

                <button
                    class="view-btn"
                    onclick="viewApplication(${index})"
                >
                    View
                </button>

                <button
                    class="delete-btn"
                    onclick="deleteApplication(${index})"
                >
                    Delete
                </button>

            </td>

        `;

        table.appendChild(row);

    });

    updateStatistics();

}


/* STATUS CLASS */

function getStatusClass(status){

    if(status === "Verified")
        return "verified";

    if(status === "Rejected")
        return "rejected";

    return "pending";

}


/* STATISTICS */

function updateStatistics(){

    document.getElementById("totalCount").textContent =
        applications.length;

    document.getElementById("pendingCount").textContent =
        applications.filter(a => a.status === "Pending").length;

    document.getElementById("verifiedCount").textContent =
        applications.filter(a => a.status === "Verified").length;

    document.getElementById("rejectedCount").textContent =
        applications.filter(a => a.status === "Rejected").length;

}


/* VIEW APPLICATION */

function viewApplication(index){

    selectedApplication = index;

    const app =
        applications[index];

    const details =
        document.getElementById("applicationDetails");

    details.innerHTML = `

        <div class="detail">
            <strong>Application ID</strong>
            ${app.id || ""}
        </div>

        <div class="detail">
            <strong>Name</strong>
            ${app.name || ""}
        </div>

        <div class="detail">
            <strong>Father / Husband Name</strong>
            ${app.fatherName || ""}
        </div>

        <div class="detail">
            <strong>Date of Birth</strong>
            ${app.dob || ""}
        </div>

        <div class="detail">
            <strong>Gender</strong>
            ${app.gender || ""}
        </div>

        <div class="detail">
            <strong>Mobile</strong>
            ${app.mobile || ""}
        </div>

        <div class="detail">
            <strong>Ration Card</strong>
            ${app.rationCard || ""}
        </div>

        <div class="detail">
            <strong>Family Members</strong>
            ${app.familyMembers || ""}
        </div>

        <div class="detail">
            <strong>District</strong>
            ${app.district || ""}
        </div>

        <div class="detail">
            <strong>Address</strong>
            ${app.address || ""}
        </div>

        <div class="detail">
            <strong>Aadhaar</strong>
            ${app.aadhaar || ""}
        </div>

    `;

    document.getElementById("statusSelect").value =
        app.status || "Pending";

    document.getElementById("detailsModal").style.display =
        "block";

}


/* CLOSE MODAL */

function closeModal(){

    document.getElementById("detailsModal").style.display =
        "none";

}


/* UPDATE STATUS */

function updateStatus(){

    if(selectedApplication === null)
        return;

    const newStatus =
        document.getElementById("statusSelect").value;

    applications[selectedApplication].status =
        newStatus;

    localStorage.setItem(
        "cmchisApplications",
        JSON.stringify(applications)
    );

    displayApplications(applications);

    closeModal();

    alert(
        "Application status updated to " +
        newStatus
    );

}


/* DELETE APPLICATION */

function deleteApplication(index){

    const confirmDelete =
        confirm(
            "Are you sure you want to delete this application?"
        );

    if(!confirmDelete)
        return;

    applications.splice(index,1);

    localStorage.setItem(
        "cmchisApplications",
        JSON.stringify(applications)
    );

    displayApplications(applications);

}


/* SEARCH */

function searchApplications(){

    const search =
        document
        .getElementById("searchInput")
        .value
        .toLowerCase();

    const filtered =
        applications.filter(app =>

            (app.id || "")
            .toLowerCase()
            .includes(search)

            ||

            (app.name || "")
            .toLowerCase()
            .includes(search)

            ||

            (app.mobile || "")
            .includes(search)

        );

    displayApplications(filtered);

}


/* CLOSE MODAL WHEN CLICKING OUTSIDE */

window.onclick = function(event){

    const modal =
        document.getElementById("detailsModal");

    if(event.target === modal){

        closeModal();

    }

}

</script>

</body>
</html>
```
