<!-- APPLICATION TABLE -->

<div class="table-container">

<table>

<thead>

<tr>

<th>
Application ID
</th>

<th>
Name
</th>

<th>
Mobile
</th>

<th>
District
</th>

<th>
Status
</th>

<th>
Action
</th>

</tr>

</thead>


<tbody
id="applicationTable"
>

</tbody>

</table>

</div>

</div>


<!-- DETAILS -->

<div
class="modal"
id="detailsModal"
>

<div class="modal-content">


<span
class="close"
id="closeModal"
>
&times;
</span>


<h2>
Application Details
</h2>


<div
id="applicationDetails"
></div>


<label>
Application Status
</label>

<select
id="statusSelect"
>

<option value="Pending">
Pending
</option>

<option value="Verified">
Verified
</option>

<option value="Rejected">
Rejected
</option>

</select>


<button
class="update-btn"
id="updateStatusButton"
>
Update Status
</button>


</div>

</div>


<!-- FIREBASE -->

<script type="module">


import {
    initializeApp
}
from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";


import {
    getAuth,
    signInWithEmailAndPassword,
    onAuthStateChanged,
    signOut
}
from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";


import {
    getFirestore,
    collection,
    getDocs,
    doc,
    updateDoc,
    deleteDoc
}
from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";


/* FIREBASE CONFIG */

const firebaseConfig = {

    apiKey:
    "AIzaSyABdobLpFZ6WaJ4kE8HQZMBmTUmfRJCbJY",

    authDomain:
    "cmchis-online-application.firebaseapp.com",

    projectId:
    "cmchis-online-application",

    storageBucket:
    "cmchis-online-application.firebasestorage.app",

    messagingSenderId:
    "275696534195",

    appId:
    "1:275696534195:web:f381966c7b5c44036a26c6",

    measurementId:
    "G-RSY7T0RVTD"

};


/* INITIALIZE */

const app =
initializeApp(firebaseConfig);


const auth =
getAuth(app);


const db =
getFirestore(app);


/* VARIABLES */

let applications = [];

let selectedDocumentId = null;


/* ELEMENTS */

const loginPage =
document.getElementById("loginPage");

const dashboard =
document.getElementById("dashboard");

const loginButton =
document.getElementById("loginButton");

const logoutButton =
document.getElementById("logoutButton");

const refreshButton =
document.getElementById("refreshButton");

const loginError =
document.getElementById("loginError");


/* LOGIN */

loginButton.addEventListener(
"click",
async function(){

    const email =
    document.getElementById("email").value.trim();

    const password =
    document.getElementById("password").value;


    loginError.textContent = "";


    if(!email || !password){

        loginError.textContent =
        "Enter your email and password.";

        return;

    }


    loginButton.disabled =
    true;

    loginButton.textContent =
    "Signing in...";


    try{

        await signInWithEmailAndPassword(
            auth,
            email,
            password
        );

    }

    catch(error){

        console.error(error);

        loginError.textContent =
        "Login failed. Check your email and password.";

        loginButton.disabled =
        false;

        loginButton.textContent =
        "Login";

    }

});


/* AUTH STATE */

onAuthStateChanged(
auth,
function(user){

    if(user){

        loginPage.style.display =
        "none";

        dashboard.style.display =
        "block";

        loadApplications();

    }

    else{

        loginPage.style.display =
        "block";

        dashboard.style.display =
        "none";

    }

});


/* LOAD APPLICATIONS */

async function loadApplications(){

    const table =
    document.getElementById("applicationTable");

    table.innerHTML =
    "<tr><td colspan='6'>Loading applications...</td></tr>";


    try{

        const snapshot =
        await getDocs(
            collection(db,"applications")
        );


        applications = [];


        snapshot.forEach(
        function(documentSnapshot){

            applications.push({

                documentId:
                documentSnapshot.id,

                ...documentSnapshot.data()

            });

        });


        applications.sort(
        function(a,b){

            return (
                String(b.submittedAt || "")
                .localeCompare(
                    String(a.submittedAt || "")
                )
            );

        });


        displayApplications(
            applications
        );

    }

    catch(error){

        console.error(error);

        table.innerHTML =
        "<tr><td colspan='6'>Unable to load applications.</td></tr>";

    }

}


/* DISPLAY */

function displayApplications(data){

    const table =
    document.getElementById("applicationTable");

    table.innerHTML = "";


    if(data.length === 0){

        table.innerHTML =
        "<tr><td colspan='6'>No applications found.</td></tr>";

        updateStatistics();

        return;

    }


    data.forEach(
    function(app){

        const row =
        document.createElement("tr");


        row.innerHTML = `

            <td>
                ${escapeHTML(app.applicationId || "")}
            </td>

            <td>
                ${escapeHTML(app.name || "")}
            </td>

            <td>
                ${escapeHTML(app.mobile || "")}
            </td>

            <td>
                ${escapeHTML(app.district || "")}
            </td>

            <td>
                <span class="status ${getStatusClass(app.status)}">
                    ${escapeHTML(app.status || "Pending")}
                </span>
            </td>

            <td>

                <button
                    class="view-btn"
                    data-id="${app.documentId}"
                    data-action="view"
                >
                    View
                </button>

                <button
                    class="delete-btn"
                    data-id="${app.documentId}"
                    data-action="delete"
                >
                    Delete
                </button>

            </td>

        `;


        table.appendChild(row);

    });


    updateStatistics();

}


/* TABLE ACTIONS */

document
.getElementById("applicationTable")
.addEventListener(
"click",
function(event){

    const button =
    event.target.closest("button");


    if(!button)
        return;


    const id =
    button.dataset.id;


    if(button.dataset.action === "view"){

        viewApplication(id);

    }


    if(button.dataset.action === "delete"){

        deleteApplication(id);

    }

});


/* VIEW */

function viewApplication(documentId){

    const app =
    applications.find(
        item =>
        item.documentId === documentId
    );


    if(!app)
        return;


    selectedDocumentId =
    documentId;


    const details =
    document.getElementById(
        "applicationDetails"
    );


    details.innerHTML = `

        ${detail(
            "Application ID",
            app.applicationId
        )}

        ${detail(
            "Name",
            app.name
        )}

        ${detail(
            "Father / Husband Name",
            app.fatherName
        )}

        ${detail(
            "Date of Birth",
            app.dob
        )}

        ${detail(
            "Gender",
            app.gender
        )}

        ${detail(
            "Mobile",
            app.mobile
        )}

        ${detail(
            "Ration Card",
            app.rationCard
        )}

        ${detail(
            "Family Members",
            app.familyMembers
        )}

        ${detail(
            "District",
            app.district
        )}

        ${detail(
            "Address",
            app.address
        )}

        ${detail(
            "Aadhaar",
            app.aadhaar
        )}

    `;


    document.getElementById(
        "statusSelect"
    ).value =
    app.status || "Pending";


    document.getElementById(
        "detailsModal"
    ).style.display =
    "block";

}


/* DETAIL */

function detail(label,value){

    return `

        <div class="detail">

            <strong>
                ${escapeHTML(label)}
            </strong>

            ${escapeHTML(value || "")}

        </div>

    `;

}


/* STATUS CLASS */

function getStatusClass(status){

    if(status === "Verified")
        return "verified";

    if(status === "Rejected")
        return "rejected";

    return "pending";

}


/* UPDATE STATUS */

document
.getElementById("updateStatusButton")
.addEventListener(
"click",
async function(){

    if(!selectedDocumentId)
        return;


    const newStatus =
    document.getElementById(
        "statusSelect"
    ).value;


    try{

        await updateDoc(

            doc(
                db,
                "applications",
                selectedDocumentId
            ),

            {
                status:newStatus
            }

        );


        alert(
            "Application status updated."
        );


        closeModal();

        await loadApplications();

    }

    catch(error){

        console.error(error);

        alert(
            "Unable to update status."
        );

    }

});


/* DELETE */

async function deleteApplication(documentId){

    const app =
    applications.find(
        item =>
        item.documentId === documentId
    );


    if(!app)
        return;


    const confirmed =
    confirm(
        "Delete application " +
        (app.applicationId || "") +
        "?"
    );


    if(!confirmed)
        return;


    try{

        await deleteDoc(

            doc(
                db,
                "applications",
                documentId
            )

        );


        await loadApplications();

    }

    catch(error){

        console.error(error);

        alert(
            "Unable to delete application."
        );

    }

}


/* SEARCH */

document
.getElementById("searchInput")
.addEventListener(
"input",
function(){

    const search =
    this.value
    .trim()
    .toLowerCase();


    const filtered =
    applications.filter(
    function(app){

        return (

            String(
                app.applicationId || ""
            )
            .toLowerCase()
            .includes(search)

            ||

            String(
                app.name || ""
            )
            .toLowerCase()
            .includes(search)

            ||

            String(
                app.mobile || ""
            )
            .includes(search)

            ||

            String(
                app.district || ""
            )
            .toLowerCase()
            .includes(search)

        );

    });


    displayApplications(
        filtered
    );

});


/* REFRESH */

refreshButton.addEventListener(
"click",
function(){

    loadApplications();

});


/* LOGOUT */

logoutButton.addEventListener(
"click",
async function(){

    await signOut(auth);

});


/* CLOSE MODAL */

document
.getElementById("closeModal")
.addEventListener(
"click",
closeModal
);


function closeModal(){

    document.getElementById(
        "detailsModal"
    ).style.display =
    "none";

    selectedDocumentId =
    null;

}


window.addEventListener(
"click",
function(event){

    const modal =
    document.getElementById(
        "detailsModal"
    );


    if(event.target === modal){

        closeModal();

    }

});


/* SECURITY: ESCAPE DISPLAYED TEXT */

function escapeHTML(value){

    return String(value)
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");

}

</script>

</body>
</html>
```
