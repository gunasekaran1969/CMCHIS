```html
<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CMCHIS Admin Dashboard</title>

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f2f6fb;
    color:#222;
}

header{
    background:linear-gradient(135deg,#0d47a1,#1976d2);
    color:white;
    text-align:center;
    padding:22px 15px;
}

header h1{
    margin:0;
    font-size:25px;
}

header p{
    margin:7px 0 0;
    font-size:14px;
}


/* LOGIN */

.login-container{
    max-width:400px;
    margin:50px auto;
    padding:15px;
}

.login-box{
    background:white;
    padding:25px;
    border-radius:15px;
    box-shadow:0 4px 15px rgba(0,0,0,.12);
}

.login-box h2{
    text-align:center;
    color:#0d47a1;
}

input,select{
    width:100%;
    padding:12px;
    margin:7px 0 15px;
    border:1px solid #ccc;
    border-radius:8px;
    font-size:15px;
}

button{
    border:0;
    padding:11px 17px;
    border-radius:7px;
    cursor:pointer;
    font-weight:bold;
}

.login-btn{
    width:100%;
    background:#1565c0;
    color:white;
    font-size:16px;
}

.login-btn:hover{
    background:#0d47a1;
}

.error{
    color:#c62828;
    text-align:center;
    margin-top:12px;
}


/* DASHBOARD */

#dashboard{
    display:none;
}

.container{
    max-width:1200px;
    margin:25px auto;
    padding:0 15px;
}

.top-bar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
    margin-bottom:20px;
}

.logout{
    background:#d32f2f;
    color:white;
}

.refresh{
    background:#1976d2;
    color:white;
    margin-right:8px;
}


/* STATISTICS */

.cards{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-bottom:25px;
}

.stat-card{
    background:white;
    padding:20px;
    border-radius:12px;
    box-shadow:0 3px 10px rgba(0,0,0,.08);
}

.stat-card h3{
    margin:0;
    color:#666;
    font-size:15px;
}

.stat-card p{
    font-size:28px;
    font-weight:bold;
    margin:10px 0 0;
    color:#0d47a1;
}


/* SEARCH */

.search-box{
    background:white;
    padding:18px;
    border-radius:12px;
    margin-bottom:20px;
}

.search-box input{
    margin:0;
}


/* TABLE */

.table-container{
    background:white;
    border-radius:12px;
    padding:15px;
    overflow-x:auto;
    box-shadow:0 3px 10px rgba(0,0,0,.08);
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:900px;
}

th{
    background:#0d47a1;
    color:white;
    padding:12px;
    text-align:left;
}

td{
    padding:11px;
    border-bottom:1px solid #ddd;
}

tr:hover{
    background:#f5f8fc;
}

.status{
    padding:6px 10px;
    border-radius:15px;
    font-size:12px;
    font-weight:bold;
}

.pending{
    background:#fff3cd;
    color:#856404;
}

.verified{
    background:#d4edda;
    color:#155724;
}

.rejected{
    background:#f8d7da;
    color:#721c24;
}

.view-btn{
    background:#1976d2;
    color:white;
}

.delete-btn{
    background:#d32f2f;
    color:white;
}


/* MODAL */

.modal{
    display:none;
    position:fixed;
    z-index:1000;
    left:0;
    top:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,.55);
    padding:20px;
    overflow:auto;
}

.modal-content{
    max-width:650px;
    margin:40px auto;
    background:white;
    border-radius:15px;
    padding:25px;
}

.close{
    float:right;
    font-size:28px;
    cursor:pointer;
}

.detail{
    margin:10px 0;
    padding:10px;
    background:#f5f7fa;
    border-radius:7px;
    word-break:break-word;
}

.detail strong{
    display:block;
    color:#555;
    margin-bottom:4px;
}

.update-btn{
    background:#1565c0;
    color:white;
    width:100%;
    margin-top:10px;
}


/* MOBILE */

@media(max-width:800px){

    .cards{
        grid-template-columns:repeat(2,1fr);
    }

}

@media(max-width:500px){

    .cards{
        grid-template-columns:1fr 1fr;
    }

    .stat-card{
        padding:14px;
    }

    .stat-card p{
        font-size:22px;
    }

}

</style>

</head>

<body>


<header>

<h1>CMCHIS Admin Dashboard</h1>

<p>
Application Management System
